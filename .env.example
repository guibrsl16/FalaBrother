# ------------------------------------------------------------------
# Brotherhood Cursos — copie este arquivo para ".env" e preencha.
# O arquivo .env fica só no seu computador (está no .gitignore).
# ------------------------------------------------------------------

# Porta do servidor de atendimento
PORTA=8787

# Onde ficam os dados (conversas, contas, credenciais dos números). Vazio = a
# pasta dados/ do projeto. Use para guardar fora da pasta do código.
PASTA_DADOS=

# Banco de dados Postgres (ex.: Supabase) para usuários, conversas, cursos,
# agentes e mensagens. Vazio = fica tudo em arquivo JSON em PASTA_DADOS
# (padrão). Preenchido = esses dados saem do disco e vão para o banco — só
# as credenciais do WhatsApp (pasta dados/conexoes/) continuam em arquivo,
# sempre, porque a biblioteca do WhatsApp exige isso.
# Formato: postgresql://usuario:senha@host:porta/postgres
DATABASE_URL=

# --------------------------- Claude (IA) ---------------------------
# Chave da API da Anthropic — https://console.anthropic.com
# É ela que faz os agentes responderem.
ANTHROPIC_API_KEY=

# Modelo usado pelos agentes. Sonnet 5 é o padrão do projeto.
MODELO_IA=claude-sonnet-5

# ------------------ WhatsApp — API oficial da Meta (OPCIONAL) ------------------
# Os números conectados por QR Code não usam nada daqui: eles são conectados
# na tela Conexões. Preencha só se for usar a Cloud API oficial, com webhook.
# Painel: https://developers.facebook.com  →  WhatsApp → Configuração da API
#
# ID do número de telefone (Phone number ID), NÃO é o número em si.
WHATSAPP_PHONE_NUMBER_ID=

# Token permanente do usuário do sistema (System User Token).
WHATSAPP_TOKEN=

# Palavra que você inventa e repete no painel da Meta ao cadastrar o webhook.
WHATSAPP_VERIFY_TOKEN=brotherat

# App Secret do aplicativo Meta. Serve para conferir a assinatura de cada
# chamada do webhook — sem ele, qualquer um poderia forjar mensagens.
WHATSAPP_APP_SECRET=

# Versão da Graph API
WHATSAPP_API_VERSION=v21.0

# ------------------------- Conexões por QR Code -------------------------
# Nível de log da biblioteca do WhatsApp (Baileys): silent, error, warn, info,
# debug. Deixe "silent" no dia a dia; use "debug" só para investigar um problema.
LOG_WHATSAPP=silent
